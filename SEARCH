#include <stdio.h>
int main()
{
    
    int arr[]={1,2,3,4,5,6,7};
    int len=sizeof(arr)/sizeof(arr[0]);
    int b;
    bool f=false;
    printf("Enter num to search:");
    scanf("%d",&b);
    for (int i=0;i<len;i++)
    {
        if(b==arr[i]){
            f=true;
            printf("K Element present in index %d",i);
            break;
        }
        
    }
    if(!f)
    printf("\n %d element not found:",b);
}
